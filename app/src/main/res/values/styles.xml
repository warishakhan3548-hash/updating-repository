<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B7CCB8</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#030705</item>
        <item name="android:navigationBarColor">#030705</item>
        <item name="android:statusBarColor">#030705</item>
    </style>

    <style name="AppTheme" parent="@style/AppThemeBase" />

    <style name="AppLaunchTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">#030705</item>
    </style>
</resources>
