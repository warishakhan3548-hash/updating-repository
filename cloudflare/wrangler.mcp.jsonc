{
  "name": "aaris-phone-mcp",
  "main": "mcp-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "AI_DEVICES", "class_name": "AiDevice" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiDevice"] }],
  "ratelimits": [{ "name": "REGISTRATION_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "ALLOWED_ORIGINS": "https://claude.ai,https://chatgpt.com" },
  "observability": { "enabled": false }
}
