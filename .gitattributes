# Large immutable source snapshots belong in Git LFS. Generated APK assets remain ignored.
source-vault/hadith/**/*.zip filter=lfs diff=lfs merge=lfs -text
source-vault/hadith/**/*.db filter=lfs diff=lfs merge=lfs -text
source-vault/hadith/**/*.sqlite filter=lfs diff=lfs merge=lfs -text
source-vault/hadith/**/*.jsonl.raw filter=lfs diff=lfs merge=lfs -text
