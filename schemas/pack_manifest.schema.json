{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content pack manifest",
  "type": "object",
  "required": [
    "pack_id",
    "schema_version",
    "content_version",
    "source_name",
    "source_version",
    "source_vault_path",
    "source_sha256",
    "licence",
    "importer_version",
    "record_count",
    "review_status",
    "built_sha256",
    "dependencies",
    "signature"
  ],
  "properties": {
    "pack_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "content_version": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "source_vault_path": {"type": "string", "pattern": "^source-vault/"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "licence": {"type": "string", "minLength": 1},
    "edition": {"type": ["string", "null"]},
    "importer_version": {"type": "string", "minLength": 1},
    "record_count": {"type": "integer", "minimum": 0},
    "review_status": {"enum": ["candidate", "reviewed", "approved"]},
    "built_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "signature": {"type": "object"}
  },
  "additionalProperties": true
}
