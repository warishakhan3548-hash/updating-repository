{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content pack manifest",
  "type": "object",
  "required": [
    "pack_id",
    "schema_version",
    "content_version",
    "source_id",
    "source_name",
    "source_version",
    "source_vault_path",
    "source_sha256",
    "licence",
    "importer_version",
    "artifact_path",
    "record_count",
    "review_status",
    "built_sha256",
    "built_byte_size",
    "dependencies",
    "signature"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_vault_path": {
      "type": "string",
      "pattern": "^source-vault/"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "importer_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^content-packs/"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_status": {
      "enum": [
        "candidate",
        "reviewed",
        "approved"
      ]
    },
    "built_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "built_byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signature": {
      "type": "object"
    },
    "notice_path": {
      "type": "string",
      "pattern": "^content-packs/"
    },
    "notice_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_attribution": {
      "type": "string",
      "minLength": 1
    },
    "source_licence_url": {
      "type": "string",
      "format": "uri"
    },
    "source_licence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_provenance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "content_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "canonical": {
      "type": "object",
      "required": [
        "canonical_id",
        "canonical_version",
        "generator_version",
        "manifest_path",
        "manifest_sha256",
        "artifact_path",
        "artifact_sha256",
        "artifact_byte_size",
        "record_count"
      ],
      "properties": {
        "canonical_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_version": {
          "type": "string",
          "minLength": 1
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "pattern": "^canonical/"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^canonical/"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "build_toolchain": {
      "type": "object",
      "required": [
        "python_implementation",
        "python_version",
        "sqlite_version"
      ],
      "properties": {
        "python_implementation": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "sqlite_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "byte_reproducibility_scope": {
      "type": "string",
      "minLength": 1
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic signed release ordering primitive; required for approved packs.",
      "maximum": 9007199254740991
    },
    "source_release_review": {
      "type": "object",
      "required": [
        "source_id",
        "source_version",
        "observed_upstream_version",
        "version_check_url",
        "checked_at",
        "licence_sha256",
        "latest_upstream_version_confirmed"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_upstream_version": {
          "type": "string",
          "minLength": 1
        },
        "version_check_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "licence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "latest_upstream_version_confirmed": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "notice_path": [
      "notice_sha256"
    ],
    "notice_sha256": [
      "notice_path"
    ]
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              2,
              3
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "source_url",
          "source_attribution",
          "source_licence_url",
          "source_licence_sha256",
          "source_provenance_sha256",
          "notice_path",
          "notice_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "content_schema_version",
          "canonical",
          "build_toolchain",
          "byte_reproducibility_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "properties": {
          "signature": {
            "type": "object",
            "required": [
              "format",
              "role",
              "signatures"
            ],
            "properties": {
              "format": {
                "const": "aaris-pack-signature-v1"
              },
              "role": {
                "const": "content-pack-release"
              },
              "signatures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "algorithm",
                    "key_id",
                    "value"
                  ],
                  "properties": {
                    "algorithm": {
                      "const": "ed25519"
                    },
                    "key_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{128}$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "release_sequence"
        ]
      }
    }
  ]
}
