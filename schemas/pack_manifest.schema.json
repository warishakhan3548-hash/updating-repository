{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content pack manifest",
  "type": "object",
  "required": [
    "pack_id",
    "schema_version",
    "content_version",
    "source_id",
    "source_name",
    "source_version",
    "source_vault_path",
    "source_sha256",
    "licence",
    "importer_version",
    "artifact_path",
    "record_count",
    "review_status",
    "built_sha256",
    "built_byte_size",
    "dependencies",
    "signature"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "content_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_vault_path": {
      "type": "string",
      "pattern": "^source-vault/"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "importer_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^content-packs/"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_status": {
      "enum": [
        "candidate",
        "reviewed",
        "approved"
      ]
    },
    "built_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "built_byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "notice_path": {
      "type": "string",
      "pattern": "^content-packs/"
    },
    "notice_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signature": {
      "type": "object"
    },
    "canonical": {
      "type": "object",
      "required": [
        "canonical_id",
        "canonical_version",
        "generator_version",
        "manifest_path",
        "manifest_sha256",
        "artifact_path",
        "artifact_sha256",
        "artifact_byte_size",
        "record_count"
      ],
      "properties": {
        "canonical_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_version": {
          "type": "string",
          "minLength": 1
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "pattern": "^canonical/"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^canonical/"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "build_toolchain": {
      "type": "object",
      "required": [
        "python_implementation",
        "python_version",
        "sqlite_version"
      ],
      "properties": {
        "python_implementation": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "sqlite_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "byte_reproducibility_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "content_schema_version",
          "canonical",
          "build_toolchain",
          "byte_reproducibility_scope"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "dependentRequired": {
    "notice_path": [
      "notice_sha256"
    ],
    "notice_sha256": [
      "notice_path"
    ]
  }
}
