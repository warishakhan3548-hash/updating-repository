{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content pack manifest",
  "type": "object",
  "required": [
    "pack_id",
    "schema_version",
    "content_version",
    "source_id",
    "source_name",
    "source_version",
    "source_vault_path",
    "source_sha256",
    "licence",
    "importer_version",
    "artifact_path",
    "record_count",
    "review_status",
    "built_sha256",
    "built_byte_size",
    "dependencies",
    "signature"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_vault_path": {
      "type": "string",
      "pattern": "^source-vault/"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "importer_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^content-packs/"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_status": {
      "enum": [
        "candidate",
        "reviewed",
        "approved"
      ]
    },
    "built_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "built_byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signature": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "payload_version": {
          "type": "string"
        },
        "trust_root_version": {
          "type": "integer",
          "minimum": 1
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "algorithm",
              "key_id",
              "value"
            ],
            "properties": {
              "algorithm": {
                "const": "ed25519"
              },
              "key_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{128}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "notice_path": {
      "type": "string",
      "pattern": "^content-packs/"
    },
    "notice_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_attribution": {
      "type": "string",
      "minLength": 1
    },
    "source_licence_url": {
      "type": "string",
      "format": "uri"
    },
    "source_licence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_provenance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1
    }
  },
  "dependentRequired": {
    "notice_path": [
      "notice_sha256"
    ],
    "notice_sha256": [
      "notice_path"
    ]
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "source_url",
          "source_attribution",
          "source_licence_url",
          "source_licence_sha256",
          "source_provenance_sha256",
          "notice_path",
          "notice_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "release_sequence"
        ],
        "properties": {
          "signature": {
            "required": [
              "payload_version",
              "trust_root_version",
              "signatures"
            ],
            "properties": {
              "payload_version": {
                "const": "aaris-pack-manifest-v1"
              },
              "signatures": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
