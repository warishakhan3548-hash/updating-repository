{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceVaultRegistryV1",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verified_at": {
      "type": "string"
    },
    "production_rule": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "source_name": {
            "type": "string"
          },
          "original_url": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "research-candidate",
              "awaiting-artifact",
              "awaiting-licence",
              "production-approved",
              "rejected"
            ]
          },
          "licence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_kind": {
            "type": "string",
            "enum": [
              "file",
              "sha256-set"
            ],
            "default": "file"
          },
          "redistribution_allowed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "commercial_use_allowed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "modification_allowed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "attribution_required": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "release_requirements": {
            "type": "object",
            "required": [
              "latest_upstream_version_required",
              "version_check_url",
              "historical_snapshot_retention_status"
            ],
            "properties": {
              "latest_upstream_version_required": {
                "type": "boolean"
              },
              "version_check_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "historical_snapshot_retention_status": {
                "enum": [
                  "unresolved",
                  "verified-allowed",
                  "verified-not-allowed"
                ]
              }
            },
            "additionalProperties": false
          },
          "vault_artifact": {
            "type": [
              "string",
              "null"
            ]
          },
          "licence_snapshot": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "licence_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "byte_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "notes": {
            "type": "string"
          },
          "component_rights_status": {
            "type": "string",
            "enum": [
              "not-applicable",
              "reviewed-clear",
              "unresolved",
              "verified-incompatible"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "awaiting-artifact"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "source_name",
                "original_url",
                "version",
                "licence_id",
                "redistribution_allowed",
                "commercial_use_allowed",
                "modification_allowed",
                "attribution_required",
                "release_requirements",
                "component_rights_status"
              ],
              "properties": {
                "source_name": {
                  "type": "string",
                  "minLength": 1
                },
                "original_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "licence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "redistribution_allowed": {
                  "const": true
                },
                "commercial_use_allowed": {
                  "const": true
                },
                "modification_allowed": {
                  "type": "boolean"
                },
                "attribution_required": {
                  "type": "boolean"
                },
                "release_requirements": {
                  "properties": {
                    "historical_snapshot_retention_status": {
                      "const": "verified-allowed"
                    }
                  }
                },
                "component_rights_status": {
                  "enum": [
                    "not-applicable",
                    "reviewed-clear"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "production-approved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "component_rights_status"
              ],
              "properties": {
                "component_rights_status": {
                  "enum": [
                    "not-applicable",
                    "reviewed-clear"
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
