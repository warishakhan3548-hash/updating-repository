\u0627\u0637\u0650\u0646\u064f\u0647\u064f: \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0644\u0650\u064a \u0627\u0644\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e.\n\u0648\u064e\u0638\u064e\u0627\u0647\u0650\u0631\u064f\u0647\u064f: \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0644\u0650\u064a \u0627\u0644\u0645\u064f\u0646\u064e\u0627\u0641\u0650\u0642\u0650\u064a\u0646\u064e.","footnotes":null},{"id":"5089","sura":"57","aya":"14","arabic_text":"\u064a\u064f\u0646\u064e\u0627\u062f\u064f\u0648\u0646\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f\u0646 \u0645\u0651\u064e\u0639\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0628\u064e\u0644\u064e\u0649\u0670 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u0641\u064e\u062a\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u062a\u064e\u0631\u064e\u0628\u0651\u064e\u0635\u06e1\u062a\u064f\u0645\u06e1 \u0648\u064e\u0671\u0631\u06e1\u062a\u064e\u0628\u06e1\u062a\u064f\u0645\u06e1 \u0648\u064e\u063a\u064e\u0631\u0651\u064e\u062a\u06e1\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u064e\u0645\u064e\u0627\u0646\u0650\u064a\u0651\u064f \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u062c\u064e\u0627\u0653\u0621\u064e \u0623\u064e\u0645\u06e1\u0631\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u063a\u064e\u0631\u0651\u064e\u0643\u064f\u0645 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u063a\u064e\u0631\u064f\u0648\u0631\u064f","translation":"\u0641\u064e\u062a\u064e\u0646\u062a\u064f\u0645\u0652: \u0623\u064e\u0647\u0652\u0644\u064e\u0643\u0652\u062a\u064f\u0645\u0652.\n\u0648\u064e\u062a\u064e\u0631\u064e\u0628\u0651\u064e\u0635\u0652\u062a\u064f\u0645\u0652: \u062a\u064e\u0631\u064e\u0642\u0651\u064e\u0628\u0652\u062a\u064f\u0645\u0652 \u062d\u064f\u0635\u064f\u0648\u0644\u064e \u0627\u0644\u0646\u0651\u064e\u0648\u064e\u0627\u0626\u0650\u0628\u0650 \u0644\u0650\u0644\u0646\u0651\u064e\u0628\u0650\u064a\u0651\u0650 - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 -\u060c \u0648\u064e\u0627\u0644\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0645\u064e\u0639\u064e\u0647\u064f.\n\u0648\u064e\u0627\u0631\u0652\u062a\u064e\u0628\u0652\u062a\u064f\u0645\u0652: \u0634\u064e\u0643\u064e\u0643\u0652\u062a\u064f\u0645\u0652 \u0641\u064a\u0650 \u0627\u0644\u0628\u064e\u0639\u0652\u062b\u0650.\n\u0648\u064e\u063a\u064e\u0631\u0651\u064e\u062a\u0652\u0643\u064f\u0645\u064f \u0627\u0644\u0652\u0623\u064e\u0645\u064e\u0627\u0646\u0650\u064a\u0651\u064f: \u062e\u064e\u062f\u064e\u0639\u064e\u062a\u0652\u0643\u064f\u0645\u064f \u0627\u0644\u0623\u064e\u0628\u064e\u0627\u0637\u0650\u064a\u0644\u064f.\n\u0623\u064e\u0645\u0652\u0631\u064f \u0627\u0644\u0644\u0651\u064e\u0647\u0650: \u0627\u0644\u0645\u064e\u0648\u0652\u062a\u064f.\n\u0627\u0644\u0652\u063a\u064e\u0631\u064f\u0648\u0631\u064f: \u0627\u0644\u0634\u0651\u064e\u064a\u0652\u0637\u064e\u0627\u0646\u064f.","footnotes":null},{"id":"5090","sura":"57","aya":"15","arabic_text":"\u0641\u064e\u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u062e\u064e\u0630\u064f \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0641\u0650\u062f\u06e1\u064a\u064e\u0629\u065e \u0648\u064e\u0644\u064e\u0627 \u0645\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652\u06da \u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670\u0643\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u064f\u06d6 \u0647\u0650\u064a\u064e \u0645\u064e\u0648\u06e1\u0644\u064e\u0649\u0670\u0643\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0628\u0650\u0626\u06e1\u0633\u064e \u0671\u0644\u06e1\u0645\u064e\u0635\u0650\u064a\u0631\u064f","translation":"\u0641\u0650\u062f\u0652\u064a\u064e\u0629\u064c: \u0639\u0650\u0648\u064e\u0636\u064c \u0644\u0650\u064a\u064f\u0641\u0652\u062a\u064e\u062f\u064e\u0649 \u0628\u0650\u0647\u0650 \u0645\u0650\u0646\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0627\u0644\u0644\u0647\u0650.\n\u0645\u064e\u0627\u0648\u064e\u0627\u0643\u064f\u0645\u064f: \u0645\u064e\u0635\u0650\u064a\u0631\u064f\u0643\u064f\u0645\u0652.\n\u0645\u064e\u0648\u0652\u0644\u064e\u0627\u0643\u064f\u0645\u0652: \u0623\u064e\u0648\u0652\u0644\u064e\u0649 \u0628\u0650\u0643\u064f\u0645\u0652.\n\u0627\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f: \u0627\u0644\u0645\u064e\u0631\u0652\u062c\u0650\u0639\u064f.","footnotes":null},{"id":"5091","sura":"57","aya":"16","arabic_text":"\u06de\u00a0\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0623\u06e1\u0646\u0650 \u0644\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646 \u062a\u064e\u062e\u06e1\u0634\u064e\u0639\u064e \u0642\u064f\u0644\u064f\u0648\u0628\u064f\u0647\u064f\u0645\u06e1 \u0644\u0650\u0630\u0650\u0643\u06e1\u0631\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u0632\u064e\u0644\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0643\u064f\u0648\u0646\u064f\u0648\u0627\u0652 \u0643\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u064f \u0641\u064e\u0637\u064e\u0627\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0623\u064e\u0645\u064e\u062f\u064f \u0641\u064e\u0642\u064e\u0633\u064e\u062a\u06e1 \u0642\u064f\u0644\u064f\u0648\u0628\u064f\u0647\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0643\u064e\u062b\u0650\u064a\u0631\u065e \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0641\u064e\u0670\u0633\u0650\u0642\u064f\u0648\u0646\u064e","translation":"\u0623\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0627\u0646\u0650: \u0623\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u062d\u0650\u0646\u0652 \u0648\u064e\u064a\u064e\u062c\u0650\u0626\u0650 \u0627\u0644\u0648\u064e\u0642\u0652\u062a\u064f\u061f!\n\u062a\u064e\u062e\u0652\u0634\u064e\u0639\u064e: \u062a\u064e\u062e\u0652\u0636\u064e\u0639\u064e\u060c \u0648\u064e\u062a\u064e\u0631\u0650\u0642\u0651\u064e\u060c \u0648\u064e\u062a\u064e\u0644\u0650\u064a\u0646\u064e.\n\u0627\u0644\u0652\u0623\u064e\u0645\u064e\u062f\u064f: \u0627\u0644\u0632\u0651\u064e\u0645\u064e\u0627\u0646\u064f.","footnotes":null},{"id":"5092","sura":"57","aya":"17","arabic_text":"\u0671\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u064a\u064f\u062d\u06e1\u064a\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0628\u064e\u0639\u06e1\u062f\u064e \u0645\u064e\u0648\u06e1\u062a\u0650\u0647\u064e\u0627\u06da \u0642\u064e\u062f\u06e1 \u0628\u064e\u064a\u0651\u064e\u0646\u0651\u064e\u0627 \u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u0653\u064a\u064e\u0670\u062a\u0650 \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0642\u0650\u0644\u064f\u0648\u0646\u064e","translation":"","footnotes":null},{"id":"5093","sura":"57","aya":"18","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u0651\u064e\u062f\u0651\u0650\u0642\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0635\u0651\u064e\u062f\u0651\u0650\u0642\u064e\u0670\u062a\u0650 \u0648\u064e\u0623\u064e\u0642\u06e1\u0631\u064e\u0636\u064f\u0648\u0627\u0652 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0642\u064e\u0631\u06e1\u0636\u064b\u0627 \u062d\u064e\u0633\u064e\u0646\u0657\u0627 \u064a\u064f\u0636\u064e\u0670\u0639\u064e\u0641\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u065e \u0643\u064e\u0631\u0650\u064a\u0645\u065e","translation":"\u0627\u0644\u0652\u0645\u064f\u0635\u0651\u064e\u062f\u0651\u0650\u0642\u0650\u064a\u0646\u064e: \u0627\u0644\u0645\u064f\u062a\u064e\u0635\u064e\u062f\u0651\u0650\u0642\u0650\u064a\u0646\u064e.\n\u0642\u064e\u0631\u0652\u0636\u064b\u0627 \u062d\u064e\u0633\u064e\u0646\u064b\u0627: \u0645\u064f\u062d\u0652\u062a\u064e\u0633\u0650\u0628\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0646\u064e\u0641\u064e\u0642\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u0652 \u0628\u0650\u0644\u064e\u0627 \u0645\u064e\u0646\u0651\u064d\u060c \u0648\u064e\u0644\u064e\u0627 \u0623\u064e\u0630\u064b\u0649.","footnotes":null},{"id":"5094","sura":"57","aya":"19","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064f\u0633\u064f\u0644\u0650\u0647\u0650\u06e6\u0653 \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u0635\u0651\u0650\u062f\u0651\u0650\u064a\u0642\u064f\u0648\u0646\u064e\u06d6 \u0648\u064e\u0671\u0644\u0634\u0651\u064f\u0647\u064e\u062f\u064e\u0627\u0653\u0621\u064f \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064f\u0647\u064f\u0645\u06e1 \u0648\u064e\u0646\u064f\u0648\u0631\u064f\u0647\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0648\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0627\u0652 \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627\u0653 \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u0650","translation":"\u0627\u0644\u0635\u0651\u0650\u062f\u0651\u0650\u064a\u0642\u064f\u0648\u0646\u064e: \u0627\u0644\u0645\u064f\u0628\u064e\u0627\u0644\u0650\u063a\u064f\u0648\u0646\u064e \u0641\u0650\u064a \u0627\u0644\u062a\u0651\u064e\u0635\u0652\u062f\u0650\u064a\u0642\u0650.\n\u0648\u064e\u0627\u0644\u0634\u0651\u064f\u0647\u064e\u062f\u064e\u0627\u0621\u064f: \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0642\u064f\u062a\u0650\u0644\u064f\u0648\u0627 \u0641\u0650\u064a \u0633\u064e\u0628\u0650\u064a\u0644\u0650 \u0627\u0644\u0644\u0647\u0650.","footnotes":null},{"id":"5095","sura":"57","aya":"20","arabic_text":"\u0671\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0651\u064e\u0645\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064f \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627 \u0644\u064e\u0639\u0650\u0628\u065e \u0648\u064e\u0644\u064e\u0647\u06e1\u0648\u065e \u0648\u064e\u0632\u0650\u064a\u0646\u064e\u0629\u065e \u0648\u064e\u062a\u064e\u0641\u064e\u0627\u062e\u064f\u0631\u064f\u06e2 \u0628\u064e\u064a\u06e1\u0646\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u062a\u064e\u0643\u064e\u0627\u062b\u064f\u0631\u065e \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0648\u06e1\u0644\u064e\u0670\u062f\u0650\u06d6 \u0643\u064e\u0645\u064e\u062b\u064e\u0644\u0650 \u063a\u064e\u064a\u06e1\u062b\u064d \u0623\u064e\u0639\u06e1\u062c\u064e\u0628\u064e \u0671\u0644\u06e1\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u064e \u0646\u064e\u0628\u064e\u0627\u062a\u064f\u0647\u064f\u06e5 \u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0647\u0650\u064a\u062c\u064f \u0641\u064e\u062a\u064e\u0631\u064e\u0649\u0670\u0647\u064f \u0645\u064f\u0635\u06e1\u0641\u064e\u0631\u0651\u0657\u0627 \u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0643\u064f\u0648\u0646\u064f \u062d\u064f\u0637\u064e\u0670\u0645\u0657\u0627\u06d6 \u0648\u064e\u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0639\u064e\u0630\u064e\u0627\u0628\u065e \u0634\u064e\u062f\u0650\u064a\u062f\u065e \u0648\u064e\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u0650\u0636\u06e1\u0648\u064e\u0670\u0646\u065e\u06da \u0648\u064e\u0645\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064f \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u062a\u064e\u0670\u0639\u064f \u0671\u0644\u06e1\u063a\u064f\u0631\u064f\u0648\u0631\u0650","translation":"\u0644\u064e\u0639\u0650\u0628\u064c: \u062a\u064e\u0644\u0652\u0639\u064e\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0627\u0644\u0623\u064e\u0628\u0652\u062f\u064e\u0627\u0646\u064f.\n\u0648\u064e\u0644\u064e\u0647\u0652\u0648\u064c: \u062a\u064e\u0644\u0652\u0647\u064f\u0648 \u0628\u0650\u0647\u064e\u0627 \u0627\u0644\u0642\u064f\u0644\u064f\u0648\u0628\u064f.\n\u0627\u0644\u0652\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u064e: \u0627\u0644\u0632\u0651\u064f\u0631\u0651\u064e\u0627\u0639\u064e\u060c \u0633\u064f\u0645\u0651\u064f\u0648\u0627 \u0628\u0650\u0630\u064e\u0644\u0650\u0643\u064e\u061b \u0644\u0650\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u064a\u064e\u0633\u0652\u062a\u064f\u0631\u064f\u0648\u0646\u064e \u0627\u0644\u062d\u064e\u0628\u0651\u064e \u0641\u064a\u0650 \u0627\u0644\u062a\u0651\u064f\u0631\u064e\u0627\u0628\u0650.\n\u064a\u064e\u0647\u0650\u064a\u062c\u064f: \u064a\u064e\u064a\u0652\u0628\u064e\u0633\u064f.\n\u062d\u064f\u0637\u064e\u0627\u0645\u064b\u0627: \u0641\u064f\u062a\u064e\u0627\u062a\u064b\u0627 \u0645\u064f\u062a\u064e\u0647\u064e\u0634\u0651\u0650\u0645\u064b\u0627.","footnotes":null},{"id":"5096","sura":"57","aya":"21","arabic_text":"\u0633\u064e\u0627\u0628\u0650\u0642\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0656 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u06e1 \u0648\u064e\u062c\u064e\u0646\u0651\u064e\u0629\u064d \u0639\u064e\u0631\u06e1\u0636\u064f\u0647\u064e\u0627 \u0643\u064e\u0639\u064e\u0631\u06e1\u0636\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0623\u064f\u0639\u0650\u062f\u0651\u064e\u062a\u06e1 \u0644\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064f\u0633\u064f\u0644\u0650\u0647\u0650\u06e6\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u0636\u06e1\u0644\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064f\u0624\u06e1\u062a\u0650\u064a\u0647\u0650 \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0630\u064f\u0648 \u0671\u0644\u06e1\u0641\u064e\u0636\u06e1\u0644\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"\u0633\u064e\u0627\u0628\u0650\u0642\u064f\u0648\u0627: \u0633\u064e\u0627\u0631\u0650\u0639\u064f\u0648\u0627 \u0645\u064f\u0633\u064e\u0627\u0631\u064e\u0639\u064e\u0629\u064e \u0627\u0644\u0645\u064f\u062a\u064e\u0633\u064e\u0627\u0628\u0650\u0642\u0650\u064a\u0646\u064e \u0641\u064a\u0650 \u0627\u0644\u0645\u0650\u0636\u0652\u0645\u064e\u0627\u0631\u0650.","footnotes":null},{"id":"5097","sura":"57","aya":"22","arabic_text":"\u0645\u064e\u0627\u0653 \u0623\u064e\u0635\u064e\u0627\u0628\u064e \u0645\u0650\u0646 \u0645\u0651\u064f\u0635\u0650\u064a\u0628\u064e\u0629\u0656 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0644\u064e\u0627 \u0641\u0650\u064a\u0653 \u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u064a \u0643\u0650\u062a\u064e\u0670\u0628\u0656 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650 \u0623\u064e\u0646 \u0646\u0651\u064e\u0628\u06e1\u0631\u064e\u0623\u064e\u0647\u064e\u0627\u0653\u06da \u0625\u0650\u0646\u0651\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u0633\u0650\u064a\u0631\u065e","translation":"\u0643\u0650\u062a\u064e\u0627\u0628\u064d: \u0647\u064f\u0648\u064e: \u0627\u0644\u0644\u0651\u064e\u0648\u0652\u062d\u064f \u0627\u0644\u0645\u064e\u062d\u0652\u0641\u064f\u0648\u0638\u064f.\n\u0646\u0651\u064e\u0628\u0652\u0631\u064e\u0623\u064e\u0647\u064e\u0627: \u0646\u064e\u062e\u0652\u0644\u064f\u0642\u064e \u0647\u064e\u0630\u0650\u0647\u0650 \u0627\u0644\u0645\u064e\u062e\u0652\u0644\u064f\u0648\u0642\u064e\u0627\u062a\u0650.","footnotes":null},{"id":"5098","sura":"57","aya":"23","arabic_text":"\u0644\u0651\u0650\u0643\u064e\u064a\u06e1\u0644\u064e\u0627 \u062a\u064e\u0623\u06e1\u0633\u064e\u0648\u06e1\u0627\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u0641\u064e\u0627\u062a\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0641\u06e1\u0631\u064e\u062d\u064f\u0648\u0627\u0652 \u0628\u0650\u0645\u064e\u0627\u0653 \u0621\u064e\u0627\u062a\u064e\u0649\u0670\u0643\u064f\u0645\u06e1\u06d7 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627 \u064a\u064f\u062d\u0650\u0628\u0651\u064f \u0643\u064f\u0644\u0651\u064e \u0645\u064f\u062e\u06e1\u062a\u064e\u0627\u0644\u0656 \u0641\u064e\u062e\u064f\u0648\u0631\u064d","translation":"\u062a\u064e\u0627\u0633\u064e\u0648\u0652\u0627: \u062a\u064e\u062d\u0652\u0632\u064e\u0646\u064f\u0648\u0627.\n\u062a\u064e\u0641\u0652\u0631\u064e\u062d\u064f\u0648\u06