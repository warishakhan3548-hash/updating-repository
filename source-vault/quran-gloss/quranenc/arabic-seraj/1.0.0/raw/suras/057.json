627 \u064a\u064f\u063a\u0652\u0644\u064e\u0628\u064f.","footnotes":null},{"id":"5101","sura":"57","aya":"26","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0623\u064e\u0631\u06e1\u0633\u064e\u0644\u06e1\u0646\u064e\u0627 \u0646\u064f\u0648\u062d\u0657\u0627 \u0648\u064e\u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a \u0630\u064f\u0631\u0651\u0650\u064a\u0651\u064e\u062a\u0650\u0647\u0650\u0645\u064e\u0627 \u0671\u0644\u0646\u0651\u064f\u0628\u064f\u0648\u0651\u064e\u0629\u064e \u0648\u064e\u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e\u06d6 \u0641\u064e\u0645\u0650\u0646\u06e1\u0647\u064f\u0645 \u0645\u0651\u064f\u0647\u06e1\u062a\u064e\u062f\u0656\u06d6 \u0648\u064e\u0643\u064e\u062b\u0650\u064a\u0631\u065e \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0641\u064e\u0670\u0633\u0650\u0642\u064f\u0648\u0646\u064e","translation":"","footnotes":null},{"id":"5102","sura":"57","aya":"27","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0642\u064e\u0641\u0651\u064e\u064a\u06e1\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0621\u064e\u0627\u062b\u064e\u0670\u0631\u0650\u0647\u0650\u0645 \u0628\u0650\u0631\u064f\u0633\u064f\u0644\u0650\u0646\u064e\u0627 \u0648\u064e\u0642\u064e\u0641\u0651\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u0650\u0639\u0650\u064a\u0633\u064e\u0649 \u0671\u0628\u06e1\u0646\u0650 \u0645\u064e\u0631\u06e1\u064a\u064e\u0645\u064e \u0648\u064e\u0621\u064e\u0627\u062a\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u062c\u0650\u064a\u0644\u064e\u06d6 \u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0671\u062a\u0651\u064e\u0628\u064e\u0639\u064f\u0648\u0647\u064f \u0631\u064e\u0623\u06e1\u0641\u064e\u0629\u0657 \u0648\u064e\u0631\u064e\u062d\u06e1\u0645\u064e\u0629\u0657\u06da \u0648\u064e\u0631\u064e\u0647\u06e1\u0628\u064e\u0627\u0646\u0650\u064a\u0651\u064e\u0629\u064b \u0671\u0628\u06e1\u062a\u064e\u062f\u064e\u0639\u064f\u0648\u0647\u064e\u0627 \u0645\u064e\u0627 \u0643\u064e\u062a\u064e\u0628\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0628\u06e1\u062a\u0650\u063a\u064e\u0627\u0653\u0621\u064e \u0631\u0650\u0636\u06e1\u0648\u064e\u0670\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0645\u064e\u0627 \u0631\u064e\u0639\u064e\u0648\u06e1\u0647\u064e\u0627 \u062d\u064e\u0642\u0651\u064e \u0631\u0650\u0639\u064e\u0627\u064a\u064e\u062a\u0650\u0647\u064e\u0627\u06d6 \u0641\u064e\u0640\u0654\u064e\u0627\u062a\u064e\u064a\u06e1\u0646\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064e\u0647\u064f\u0645\u06e1\u06d6 \u0648\u064e\u0643\u064e\u062b\u0650\u064a\u0631\u065e \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0641\u064e\u0670\u0633\u0650\u0642\u064f\u0648\u0646\u064e","translation":"\u0642\u064e\u0641\u0651\u064e\u064a\u0652\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u0649 \u0622\u062b\u064e\u0627\u0631\u0650\u0647\u0650\u0645: \u0623\u064e\u062a\u0652\u0628\u064e\u0639\u0652\u0646\u064e\u0627\u0647\u064f\u0645\u0652\u060c \u0648\u064e\u0628\u064e\u0639\u064e\u062b\u0652\u0646\u064e\u0627 \u0628\u064e\u0639\u0652\u062f\u064e\u0647\u064f\u0645\u0652.\n\u0648\u064e\u0631\u064e\u0647\u0652\u0628\u064e\u0627\u0646\u0650\u064a\u0651\u064e\u0629\u064b: \u063a\u064f\u0644\u064f\u0648\u0651\u064b\u0627 \u0641\u0650\u064a \u0627\u0644\u062a\u0651\u064e\u0639\u064e\u0628\u0651\u064f\u062f\u0650.\n\u0645\u064e\u0627 \u0643\u064e\u062a\u064e\u0628\u0652\u0646\u064e\u0627\u0647\u064e\u0627: \u064