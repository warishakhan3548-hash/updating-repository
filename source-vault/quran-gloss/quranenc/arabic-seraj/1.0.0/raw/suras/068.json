u0645\u0652\u0648\u064e\u0627\u0644\u0650 \u0648\u064e\u0627\u0644\u0646\u0651\u0650\u0639\u064e\u0645\u0650\u061b \u0627\u0633\u0652\u062a\u0650\u062f\u0652\u0631\u064e\u0627\u062c\u064b\u0627 \u0644\u064e\u0647\u064f\u0645\u0652.","footnotes":null},{"id":"5316","sura":"68","aya":"45","arabic_text":"\u0648\u064e\u0623\u064f\u0645\u06e1\u0644\u0650\u064a \u0644\u064e\u0647\u064f\u0645\u06e1\u06da \u0625\u0650\u0646\u0651\u064e \u0643\u064e\u064a\u06e1\u062f\u0650\u064a \u0645\u064e\u062a\u0650\u064a\u0646\u064c","translation":"\u0648\u064e\u0623\u064f\u0645\u0652\u0644\u0650\u064a \u0644\u064e\u0647\u064f\u0645\u0652: \u0623\u064f\u0645\u0652\u0647\u0650\u0644\u064f\u0647\u064f\u0645\u0652\u060c \u0648\u064e\u0623\u064f\u0637\u0650\u064a\u0644\u064f \u0623\u064e\u0639\u0652\u0645\u064e\u0627\u0631\u064e\u0647\u064f\u0645\u0652.\n\u0645\u064e\u062a\u0650\u064a\u0646\u064c: \u0642\u064e\u0648\u0650\u064a\u0651\u064c\u060c \u0634\u064e\u062f\u0650\u064a\u062f\u064c.","footnotes":null},{"id":"5317","sura":"68","aya":"46","arabic_text":"\u0623\u064e\u0645\u06e1 \u062a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u0657\u0627 \u0641\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u063a\u06e1\u0631\u064e\u0645\u0656 \u0645\u0651\u064f\u062b\u06e1\u0642\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u0645\u0651\u064e\u063a\u0652\u0631\u064e\u0645\u064d: \u063a\u064e\u0631\u064e\u0627\u0645\u064e\u0629\u0650 \u062a\u0650\u0644\u0652\u0643\u064e \u0627\u0644\u0623\u064f\u062c\u0652\u0631\u064e\u0629\u0650.\n\u0645\u0651\u064f\u062b\u0652\u0642\u064e\u0644\u064f\u0648\u0646\u064e: \u0645\u064f\u0643\u064e\u0644\u0651\u064e\u0641\u064f\u0648\u0646\u064e \u062d\u0650\u0645\u0652\u0644\u064b\u0627 \u062b\u064e\u0642\u0650\u064a\u0644\u064b\u0627.","footnotes":null},{"id":"5318","sura":"68","aya":"47","arabic_text":"\u0623\u064e\u0645\u06e1 \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u0645\u064f \u06