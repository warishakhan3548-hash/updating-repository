4\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 -.","footnotes":null},{"id":"4861","sura":"54","aya":"15","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f \u062a\u0651\u064e\u0631\u064e\u0643\u06e1\u0646\u064e\u0670\u0647\u064e\u0627\u0653 \u0621\u064e\u0627\u064a\u064e\u0629\u0657 \u0641\u064e\u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u0656","translation":"\u062a\u0651\u064e\u0631\u064e\u0643\u0652\u0646\u064e\u0627\u0647\u064e\u0627 \u0622\u064a\u064e\u0629\u064b: \u0623\u064e\u0628\u0652\u0642\u064e\u064a\u0652\u0646\u064e\u0627 \u0642\u0650\u0635\u0651\u064e\u0629\u064e \u0646\u064f\u0648\u062d\u064d - \u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 -\u060c \u0648\u064e\u0639\u064f\u0642\u064f\u0648\u0628\u064e\u0629\u064e \u0642\u064e\u0648\u0652\u0645\u0650\u0647\u0650\u061b \u0639\u0650\u0628\u0652\u0631\u064e\u0629\u064b\u060c \u0648\u064e\u062f\u064e\u0644\u0650\u064a\u0644\u064b\u0627 \u0639\u064e\u0644\u064e\u0649 \u0642\u064f\u062f\u0652\u0631\u064e\u062a\u0650\u0646\u064e\u0627.\n\u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u064d: \u0645\u064f\u0639\u0652\u062a\u064e\u0628\u0650\u0631\u064d\u060c \u0648\u064e\u0645\u064f\u062a\u0651\u064e\u0639\u0650\u0638\u064d.","footnotes":null},{"id":"4862","sura":"54","aya":"16","arabic_text":"\u0641\u064e\u0643\u064e\u064a\u06e1\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"\u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650: \u0625\u0650\u0646\u0652\u0630\u064e\u0627\u0631\u0650\u064a.","footnotes":null},{"id":"4863","sura":"54","aya":"17","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u064a\u064e\u0633\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e \u0644\u0650\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u0650 \u0641\u064e\u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064f\u062f\u0651\u064e\u0643\u0650\u0631\u0656","translation":"","footnotes":null},{"id":"4864","sura":"54","aya":"18","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u06e1 \u0639\u064e\u0627\u062f\u065e \u0641\u064e\u0643\u064e\u064a\u06e1\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u0650\u064a \u0648\u064e\u0646\u064f\u0630\u064f\u0631\u0650","translation":"","footnotes":null},{"id":"4865","sura":"54","aya":"19","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0631\u06e1\u0633\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0631\u0650\u064a\u062d\u0657\u0627 \u0635\u064e\u0631\u06e1\u0635\u064e\u0631\u0657\u0627 \u0641\u0650\u064a \u064a\u064e\u0648\u06e1\u0645\u0650 \u0646\u064e\u062d\u06e1\u0633\u0656 \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0645\u0650\u0631\u0651\u0656","translation":"\u0635\u064e\u0631\u0652\u0635\u064e\u0631\u064b\u0627: \u0634\u064e\u062f\u0650\u064a\u062f\u064e\u0629\u064e \u0627\u0644\u0628\u064e\u0631\u0652\u062f\u0650.\n\u064a\u064e\u0648\u0652\u0645\u0650 \u0646\u064e\u062d\u0652\u0633\u064d: \u064a\u064e\u0648\u0652\u0645\u0650 \u0634\u064f\u0624\u0652\u0645\u064d.\n\u0645\u0651\u064f\u0633\u0652\u062a\u064e\u0645\u0650\u0631\u0651\u064d: \u062f\u064e\u0627\u0626\u0650\u0645\u0650 \u0627\u0644\u0634\u0651\u064f\u0624\u0652\u0645\u0650.","footnotes":null},{"id":"4866","sura":"54","aya":"20","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u0639\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064e \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u0639\u06e1\u062c\u064e\u0627\u0632\u064f \u0646\u064e\u062e\u06e1\u0644\u0656 \u0645\u0651\u064f\u0646\u0642\u064e\u0639\u0650\u0631\u0656","translation":"\u062a\u064e\u0646\u0632\u0650\u0639\u064f \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u064e: \u062a\u064e\u0642\u0652\u062a\u064e\u0644\u06