4f\u0644\u0651\u064f\u0643\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u062a\u0650\u062c\u064e\u0670\u0631\u064e\u0629\u0656 \u062a\u064f\u0646\u062c\u0650\u064a\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u0656","translation":"","footnotes":null},{"id":"5174","sura":"61","aya":"11","arabic_text":"\u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u062a\u064f\u062c\u064e\u0670\u0647\u0650\u062f\u064f\u0648\u0646\u064e \u0641\u0650\u064a \u0633\u064e\u0628\u0650\u064a\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0628\u0650\u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u06e1 \u0648\u064e\u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u06e1\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u06e1 \u062e\u064e\u064a\u06e1\u0631\u065e \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"","footnotes":null},{"id":"5175","sura":"61","aya":"12","arabic_text":"\u064a\u064e\u063a\u06e1\u0641\u0650\u0631\u06e1 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0630\u064f\u0646\u064f\u0648\u0628\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u064a\u064f\u062f\u06e1\u062e\u0650\u0644\u06e1\u0643\u064f\u0645\u06e1 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u062a\u064e\u062c\u06e1\u0631\u0650\u064a \u0645\u0650\u0646 \u062a\u064e\u062d\u06e1\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0646\u06e1\u0647\u064e\u0670\u0631\u064f \u0648\u064e\u0645\u064e\u0633\u064e\u0670\u0643\u0650\u0646\u064e \u0637\u064e\u064a\u0651\u0650\u0628\u064e\u0629\u0657 \u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0650 \u0639\u064e\u062f\u06e1\u0646\u0656\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u0641\u064e\u0648\u06e1\u0632\u064f \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u064f","translation":"","footnotes":null},{"id":"5176","sura":"61","aya":"13","arabic_text":"\u0648\u064e\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670 \u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e\u0647\u064e\u0627\u06d6 \u0646\u064e\u0635\u06e1\u0631\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0641\u064e\u062a\u06e1\u062d\u065e \u0642\u064e\u0631\u0650\u064a\u0628\u065e\u06d7 \u0648\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u0650 \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e","translation":"\u0648\u064e\u0623\u064f\u062e\u0652\u0631\u064e\u0649: \u0648\u064e\u0646\u0650\u0639\u0652\u0645\u064e\u0629\u064c \u0623\u064f\u062e\u0652\u0631\u064e\u0649 \u0644\u064e\u0643\u064f\u0645\u0652.","footnotes":null},{"id":"5177","sura":"61","aya":"14","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0643\u064f\u0648\u0646\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0643\u064e\u0645\u064e\u0627 \u0642\u064e\u0627\u0644\u064e \u0639\u0650\u064a\u0633\u064e\u0649 \u0671\u0628\u06e1\u0646\u064f \u0645\u064e\u0631\u06e1\u064a\u064e\u0645\u064e \u0644\u0650\u0644\u06e1\u062d\u064e\u0648\u064e\u0627\u0631\u0650\u064a\u0651\u0650\u0640\u06e7\u0646\u064e \u0645\u064e\u0646\u06e1 \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u0650\u064a\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06d6 \u0642\u064e\u0627\u0644\u064e \u0671\u0644\u06e1\u062d\u064e\u0648\u064e\u0627\u0631\u0650\u064a\u0651\u064f\u0648\u0646\u064e \u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06d6 \u0641\u064e\u0640\u0654\u064e\u0627\u0645\u064e\u0646\u064e\u062a \u0637\u0651\u064e\u0627\u0653\u0626\u0650\u0641\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u06e2 \u0628\u064e\u0646\u0650\u064a\u0653 \u0625\u0650\u0633\u06e1\u0631\u064e\u0670\u0653\u0621\u0650\u064a\u0644\u064e \u0648\u064e\u0643\u064e\u0641\u064e\u0631\u064e\u062a \u0637\u0651\u064e\u0627\u0653\u0626\u0650\u0641\u064e\u0629\u065e\u06d6 \u0641\u064e\u0623\u064e\u064a\u0651\u064e\u062f\u06e1\u0646\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u0639\u064e\u062f\u064f\u0648\u0651\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0623\u064e\u0635\u06e1\u0628\u064e\u062d\u064f\u0648\u0627\u0652 \u0638\u064e\u0670\u0647\u0650\u0631\u0650\u064a\u0646\u064e","translation":"\u0644\u0650\u0644\u0652\u062d\u064e\u0648\u064e\u0627\u0631\u0650\u064a\u0651\u0650\u064a\u0646\u064e: \u0623\u064e\u0635\u0652\u0641\u0650\u064a\u064e\u0627\u0621\u0650 \u0639\u0650\u064a\u0633\u064e\u0649 - \u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 -\u060c \u0648\u064e\u062e\u064e\u0648\u064e\u0627\u0635\u0651\u0650\u0647\u0650.\n\u0641\u064e\u0623\u064e\u064a\u0651\u064e\u062f\u0652\u0646\u064e\u0627: \u0642\u064e\u0648\u0651\u064e\u064a\u0652\u0646\u064e\u0627\u060c \u0648\u064e\u0646\u064e\u0635\u064e\u0631\u0652\u0646\u064e\u0627.\n\u0638\u064e\u0627\u0647\u0650\u0631\u0650\u064a\u0646\u064e: \u063a\u064e\u0627\u0644\u0650\u0628\u0650\u064a\u0646\u064e.","footnotes":null}]}