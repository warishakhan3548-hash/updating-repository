{
  "rules": {
    ".read": false,
    ".write": false,

    "pairingCodes": {
      ".read": false,
      ".write": false
    },
    "serverSessionCodes": {
      ".read": false,
      ".write": false
    },
    "activeHostSession": {
      ".read": false,
      ".write": false
    },
    "redeemRate": {
      ".read": false,
      ".write": false
    },

    "sessions": {
      "$sessionId": {
        ".read": "auth != null && (data.child('hostUid').val() === auth.uid || data.child('controllerUid').val() === auth.uid)",

        "controllerSignal": {
          ".write": "auth != null && root.child('sessions').child($sessionId).child('controllerUid').val() === auth.uid && (root.child('sessions').child($sessionId).child('state').val() === 'SCREEN_READY' || root.child('sessions').child($sessionId).child('state').val() === 'LIVE')",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50000)"
        },
        "hostSignal": {
          ".write": "auth != null && root.child('sessions').child($sessionId).child('hostUid').val() === auth.uid && (root.child('sessions').child($sessionId).child('state').val() === 'SCREEN_READY' || root.child('sessions').child($sessionId).child('state').val() === 'LIVE')",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50000)"
        },
        "controllerCandidates": {
          "$candidateId": {
            ".write": "auth != null && root.child('sessions').child($sessionId).child('controllerUid').val() === auth.uid && (root.child('sessions').child($sessionId).child('state').val() === 'SCREEN_READY' || root.child('sessions').child($sessionId).child('state').val() === 'LIVE')",
            ".validate": "newData.isString() && newData.val().length <= 4096 && $candidateId.matches(/^(0[0-8][0-9]|09[0-5])$/)"
          }
        },
        "hostCandidates": {
          "$candidateId": {
            ".write": "auth != null && root.child('sessions').child($sessionId).child('hostUid').val() === auth.uid && (root.child('sessions').child($sessionId).child('state').val() === 'SCREEN_READY' || root.child('sessions').child($sessionId).child('state').val() === 'LIVE')",
            ".validate": "newData.isString() && newData.val().length <= 4096 && $candidateId.matches(/^(0[0-8][0-9]|09[0-5])$/)"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('sessions').child($sessionId).child('hostUid').val() === auth.uid || root.child('sessions').child($sessionId).child('controllerUid').val() === auth.uid) && (root.child('sessions').child($sessionId).child('state').val() === 'SCREEN_READY' || root.child('sessions').child($sessionId).child('state').val() === 'LIVE')",
            ".validate": "!newData.exists() || newData.isBoolean()"
          }
        }
      }
    }
  }
}
