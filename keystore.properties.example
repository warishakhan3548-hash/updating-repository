# Copy this file to keystore.properties and keep the real file private.
# The repository .gitignore excludes keystore.properties and all common keystore formats.
AARIS_KEYSTORE_PATH=/absolute/path/to/Aarish-upload-keystore.jks
AARIS_KEYSTORE_PASSWORD=replace-with-private-store-password
AARIS_KEY_ALIAS=upload
# Optional. Omit when the private-key password is the same as the store password.
# AARIS_KEY_PASSWORD=replace-with-private-key-password
